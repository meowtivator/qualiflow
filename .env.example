# Supabase project connection
# Copy this file to apps/web/.env.local.
# Local Supabase defaults usually look like:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local publishable key>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this in browser code.
# Used later for admin/setup/seed automation.
SUPABASE_SECRET_KEY=

# Temporary demo switch. Set to 1 to make the app public (skip the login gate).
# Only mock data is shown; no real Supabase data is rendered. Unset or 0 = auth on.
QUALIFLOW_DISABLE_AUTH=

# Temporary shared-password gate (HTTP Basic Auth) that stands in for Supabase auth.
# Set a password to require it before entering; leave empty to disable the gate.
# Lives only here / in the host env — never commit a real password.
QUALIFLOW_DEMO_PASSWORD=
