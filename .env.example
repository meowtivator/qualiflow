# =============================================================================
# QualiFlow 환경변수 — 이 파일을 apps/web/.env.local 로 복사해서 값을 채운다.
# =============================================================================
#
# ★로컬 DB ↔ 클라우드 DB 전환은 '코드 변경 없이' 아래 Supabase 3개 값만 바꾸면 된다.
#   앱은 이 env가 가리키는 Supabase를 그대로 쓴다.
#
#   - 로컬(개발):   `supabase start` 후 출력되는 로컬 값
#       NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#       NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<로컬 publishable/anon 키>
#       SUPABASE_SECRET_KEY=<로컬 service/secret 키>
#
#   - 클라우드:     Supabase 대시보드 → Project Settings → API 에서 복사
#       NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#       NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<클라우드 publishable/anon 키>   (브라우저 노출 OK)
#       SUPABASE_SECRET_KEY=<클라우드 service/secret 키>                      (서버 전용, 절대 노출 금지)
#     ⚠️ 클라우드로 바꾼 뒤엔 마이그레이션을 클라우드 DB에 적용해야 한다:
#         supabase link --project-ref <project-ref>   (1회)
#         supabase db push                            (supabase/migrations 전부 클라우드에 반영)
#     ⚠️ NEXT_PUBLIC_* 는 빌드타임에 번들에 박힌다 → 배포 컨테이너는 이 값으로 '빌드'해야 한다.
#        로컬 `next dev`는 재시작 시 .env.local 을 다시 읽으므로 값만 바꾸고 재시작하면 된다.
# =============================================================================

# --- Supabase 연결 (로컬 또는 클라우드 — 위 가이드대로 한 세트만 채운다) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this in browser code. (관리/시드/ingest 함수 호출 등 서버 전용)
SUPABASE_SECRET_KEY=

# --- 에이전트 페어링 시크릿 (서버 전용) ---
# 페어링 코드/에이전트 토큰의 HMAC pepper. `openssl rand -base64 32` 로 한 번 생성해서 호스트 env에만 둔다.
# DB엔 해시만 저장 → 이 pepper 없이는 DB 덤프로도 코드/토큰을 역산 못 한다. NEXT_PUBLIC_ 금지, 실값 커밋 금지.
# ★한 번 정하면 바꾸지 말 것(바꾸면 기존 페어링 토큰/코드가 전부 무효).
QUALIFLOW_PAIRING_PEPPER=

# --- 에이전트가 붙을 서버(클라우드) 주소 ---
# 로컬 에이전트(apps/agent)가 pair/ingest/commands를 호출할 베이스 URL. 기본값은 http://localhost:3000.
# 배포 시 에이전트 쪽 env로: QUALIFLOW_CLOUD_URL=https://qualiflow.meowti.kr
# (이건 '에이전트'가 읽는 값이라 apps/web/.env.local 이 아니라 에이전트 실행 환경에 둔다.)
QUALIFLOW_CLOUD_URL=

# --- 로컬/데모 전용 스위치 (배포에선 절대 켜지 말 것) ---
# 로그인 게이트를 건너뛴다(데모). 인박스 데이터 소스는 별도로 선택됨:
#   로그인 + DB에 데이터 -> DB / .data/*.json 있으면 -> Real JSON preview / 없으면 -> mock
QUALIFLOW_DISABLE_AUTH=

# 임시 공유 비밀번호 게이트(HTTP Basic). 값 넣으면 공유 프리뷰 진입 전 비번 요구, 비우면 끔. 실값 커밋 금지.
QUALIFLOW_DEMO_PASSWORD=

# Dev 전용 시드 로그인. 1로 켜면(NODE_ENV != production) POST /api/dev/login 활성(OTP 없이 시드 사용자 로그인).
# SUPABASE_SECRET_KEY 필요. 프로덕션에선 무조건 404. 배포에 절대 설정 금지.
QUALIFLOW_DEV_SEED_LOGIN=
