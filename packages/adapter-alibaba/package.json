{
  "name": "@qualiflow/adapter-alibaba",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Alibaba inbound buyer adapter and discovery helpers for QualiFlow.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "headless:discover": "tsx ./src/cli/headless-discover.ts",
    "inquiry:record": "tsx ./src/cli/record-inquiry.ts",
    "inquiry:login": "tsx ./src/cli/login-session.ts",
    "inquiry:extract": "tsx ./src/cli/extract-session.ts",
    "normalize:check": "tsx ./src/normalize.check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qualiflow/core": "workspace:*",
    "playwright-core": "1.58.2"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
