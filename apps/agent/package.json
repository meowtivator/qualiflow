{
  "name": "@qualiflow/agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "QualiFlow local agent — pairs with the cloud and reads channel inboxes on the user's machine.",
  "scripts": {
    "agent": "tsx ./src/cli.ts",
    "accounts": "tsx ./src/cli.ts accounts",
    "status": "tsx ./src/cli.ts status",
    "bundle": "node build.mjs",
    "package": "node package-app.mjs",
    "dist:macos": "node make-dist-macos.mjs",
    "dist:windows": "node make-dist-windows.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qualiflow/adapter-alibaba": "workspace:*",
    "@qualiflow/adapter-chat": "workspace:*",
    "@qualiflow/core": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "playwright-core": "1.58.2",
    "qrcode-terminal": "^0.12.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.28.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
